# UniVoice 환경변수 예시. 이 파일을 .env로 복사해 값을 채운다.
# core/config.py 의 Settings 필드명(소문자)과 매핑된다 (pydantic-settings는 대소문자 무시).

# ── PostgreSQL ────────────────────────────────────
# psycopg 3 커넥션 문자열 하나로 받는다 (repo/pool.py 가 이걸 그대로 쓴다).
DATABASE_URL=postgresql://app:app@localhost:5432/univoice

# ── Redis ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM (AWS Bedrock) ─────────────────────────────
# 리전·자격증명은 지정하지 않는다 (EC2 인스턴스 프로파일이 자동으로 잡힌다).
# global. 추론 프로필을 쓴다 — raw 모델 id는 on-demand 미지원.
LLM_MODEL_ID=global.anthropic.claude-sonnet-5

# ── App ───────────────────────────────────────────
PORT=8501

# ── 세션/잠금 TTL (초) — 필요 시 조정 ──────────────
# LOGIN_SESSION_TTL_SECONDS=86400
# TURN_LOCK_TTL_SECONDS=30
# COMPACT_LOCK_TTL_SECONDS=60
