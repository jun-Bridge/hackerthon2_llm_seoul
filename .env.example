POSTGRES_PASSWORD=

# ── Redis ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── App ───────────────────────────────────────────
PORT=8080
CORS_ORIGINS=http://localhost:5173

# ── Frontend (Vite — VITE_ 접두사만 브라우저에 노출됨) ──
VITE_API_BASE_URL=http://localhost:8080
